# Azure AI Foundry Configuration
# Get endpoint from: Foundry portal → your project → Settings → Project details
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Model deployment name (as shown in Foundry → Models)
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano

# Agent name (used for logging/identification only)
FOUNDRY_AGENT_NAME=account-agent

# --- Authentication (choose one) ---

# Option A: API Key (simpler)
# Get from: Foundry portal → Settings → API keys
FOUNDRY_API_KEY=

# Option B: Azure CLI (requires 'az login')
# Leave FOUNDRY_API_KEY empty and set:
AZURE_CREDENTIAL_TYPE=AzureCliCredential

# A2A Server Port
ACCOUNT_A2A_PORT=8002